{
  "name": "fullstack-starter",
  "private": true,
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @app/api --filter @app/web dev",
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "test": "pnpm --recursive --if-present test",
    "db:generate": "pnpm --filter @app/api db:generate",
    "db:migrate": "pnpm --filter @app/api db:migrate"
  }
}
