# Root environment for deploy/orchestration tooling (loaded by direnv and `just`).
# Copy this file to `.env` and fill in the secret values. NEVER commit `.env`.
#
# Note: the application's own runtime config lives in apps/api/.env
# (see apps/api/.env.example). This root file is for tooling such as the
# Komodo deploy recipes.

# --- Komodo (deploy tooling) ---
# Komodo Core base URL. This is not a secret; the real instance is the default.
KOMODO_URL=https://komodo-ckn-omv-main.lyra-on.top

# Service-user API credentials. Create these in the Komodo UI under
# Settings -> Profile -> API Keys for the service user, then paste them into `.env`.
# Komodo authenticates API calls with these two headers: X-Api-Key / X-Api-Secret.
# Leave empty here; fill the real values only in `.env` (gitignored).
KOMODO_API_KEY=
KOMODO_API_SECRET=
