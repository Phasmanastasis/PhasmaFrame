{
  "expo": {
    "name": "PhasmaFrame",
    "slug": "phasmaframe",
    "scheme": "phasmaframe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "org.phasmaframe.app"
    }
  }
}
