{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && if [ -d ../patient ]; then pnpm --dir ../patient run build && cp ../patient/dist/index.html dist/index.html && rm -rf dist/_expo && cp -R ../patient/dist/_expo dist/_expo && mkdir -p dist/assets && cp -R ../patient/dist/assets/. dist/assets/; fi",
    "check": "astro check",
    "cf:dev": "wrangler pages dev",
    "cf:deploy": "wrangler pages deploy dist --project-name=kasigla"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@astrojs/react": "^4.4.2",
    "astro": "^5.13.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "wrangler": "^4.68.0"
  }
}
