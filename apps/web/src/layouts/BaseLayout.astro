---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Astro and Hono full-stack starter" />
    <link rel="icon" type="image/png" href="/kasigla-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
