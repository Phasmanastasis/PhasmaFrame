---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  showNav?: boolean;
  manifestPath?: string;
}

const { title, showNav = true, manifestPath = '/manifest.webmanifest' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Record patient blood pressure and heart rate for local BHW review and follow-up." />
    <link rel="icon" type="image/png" href="/kasigla-logo.png" />
    <link rel="manifest" href={manifestPath} />
    <meta name="theme-color" content="#f8f9f5" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Kasigla" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <script>
      import '../scripts/register-sw.ts';
    </script>
  </head>
  <body>
    {showNav && <Nav />}
    <slot />
  </body>
</html>
