---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f9f5" />
    <meta name="description" content="A BHW follow-up portal for reviewing offline blood pressure records and preparing RHU summaries." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/offline-worker.js'));
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
