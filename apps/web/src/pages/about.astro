---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Kasigla">
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">About</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">About Kasigla</h1>
    <div class="mt-6 rounded-lg border border-emerald-200 bg-white p-6 shadow-sm">
      <p class="leading-7 text-slate-600">
        Kasigla is an offline-first companion for hypertension follow-up. It helps you keep track of
        your care between visits, so your readings and reminders are always close at hand — even
        without a connection.
      </p>
      <p class="mt-4 leading-7 text-slate-600">
        Installed as a progressive web app, Kasigla loads instantly and keeps working offline. Your
        core screens stay available from the local cache, and the app reconnects automatically when
        you are back online.
      </p>
    </div>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-emerald-800 transition hover:bg-emerald-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
      >
        ← Back home
      </a>
    </p>
  </main>
</BaseLayout>
