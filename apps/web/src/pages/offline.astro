---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="You're offline">
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Offline</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">You're offline</h1>
    <div class="mt-6 rounded-lg border border-emerald-200 bg-white p-6 shadow-sm">
      <p class="leading-7 text-slate-600">
        It looks like you've lost your connection. Kasigla keeps your core screens cached, so you
        can still get around. We'll reconnect automatically once you're back online.
      </p>
    </div>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-emerald-800 transition hover:bg-emerald-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
      >
        ← Back home
      </a>
    </p>
  </main>
</BaseLayout>
