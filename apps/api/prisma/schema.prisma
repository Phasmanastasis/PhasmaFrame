generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working; "debian-openssl-3.0.x" is the engine for the
  // Docker runtime (node:22-bookworm-slim) used in deployment.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Example {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}
