generator client {
  provider        = "prisma-client-js"
  // "driverAdapters" lets the client run on the Cloudflare Workers runtime via the
  // @prisma/adapter-d1 driver (D1 is Cloudflare's SQLite). It does not affect the
  // Node/Komodo path, which keeps using the bundled query engine below.
  previewFeatures = ["driverAdapters"]
  // "native" keeps local dev working; "debian-openssl-3.0.x" is the engine for the
  // Docker runtime (node:22-bookworm-slim) used in the Komodo deployment.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Example {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}
