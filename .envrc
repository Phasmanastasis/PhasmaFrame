# direnv configuration for PhasmaFrame.
#
# This file contains no secrets — only directives telling direnv which env files to
# load — so it is safe to commit. The actual secret-bearing .env files are gitignored.
#
# Node version: this project targets Node.js 20.19+ or 22.12+ (see README; package.json
# has no `engines` field and the repo ships no .nvmrc/.node-version, so no version-manager
# logic is added here). Use nvm/fnm/volta yourself if you want automatic switching.

# Root .env (optional). `just` also loads this via `set dotenv-load`, so the two are
# redundant by design: direnv covers interactive shells, dotenv-load covers `just`/CI.
dotenv_if_exists .env

# The API reads its environment from apps/api/.env (copy apps/api/.env.example to start).
dotenv_if_exists apps/api/.env

# Reload the environment when any of these change.
watch_file .env
watch_file apps/api/.env
watch_file apps/api/.env.example
